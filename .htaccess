<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block access to .git, .env, and sensitive files
    RewriteRule ^\.git - [F,L]
    RewriteRule ^\.env - [F,L]

    # 1. 301 Redirect any direct browser request containing /public/ or /public to root path
    RewriteCond %{REQUEST_METHOD} !POST
    RewriteCond %{THE_REQUEST} \s/+(?:public/|public$)([^\s?]*) [NC]
    RewriteRule ^ /%1 [R=301,L,NE,QSA]

    # 2. Internally route all requests into public folder
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

