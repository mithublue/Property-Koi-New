<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block access to .git, .env, and sensitive files
    RewriteRule ^\.git - [F,L]
    RewriteRule ^\.env - [F,L]

    # 1. 301 Redirect any direct browser request containing /public to clean URL
    RewriteCond %{REQUEST_METHOD} !POST
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(?:public/(.*)|public(\?.*)?)\sHTTP [NC]
    RewriteRule ^ https://%{HTTP_HOST}/%1 [R=301,L,NE,QSA]

    # 2. Internally route all requests into public folder
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

